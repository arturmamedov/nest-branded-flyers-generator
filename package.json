{
  "name": "nest-branded-flyers-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Internal mini-app: branded 1080x1920 Instagram-story flyers for Nests Hostels.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./data/** server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "seed": "node dist-server/server/cli/seed.js",
    "seed:dev": "tsx server/cli/seed.ts",
    "seed:samples": "tsx server/cli/seedSamples.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:render": "npm run build && playwright test",
    "compare:design": "tsx scripts/compare-design.ts",
    "gen": "tsx scripts/gen-shared.ts",
    "test:contract": "vitest run -c vitest.contract.config.ts"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/shantell-sans": "5.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "modern-screenshot": "4.7.0",
    "multer": "^2.4.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
