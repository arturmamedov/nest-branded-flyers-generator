# Staff photos: the fallback for uploads/.htaccess (docs/deploy.md, step 1b),
# used together with the app root's .htaccess-minimal, only when the host
# refuses "Options" or "php_flag" here and every photo answers 500.
#
# The same rules as the full file (tests/unit/htaccess.test.ts), without those
# lines: the root .htaccess-minimal refuses folder listings instead, and PHP is
# kept from running here by the handler and name rules below.

# Hosts that map PHP by extension (AddHandler or AddType, as Laragon does): unmap it here.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .phps .pht
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .phps .pht

# A PHP-looking extension anywhere in the name (x.php, x.php.png, X.PHTML): refused.
<FilesMatch "(?i)\.ph(p\d?|tml|ar|ps|t)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Every name that does not end in .jpg, .jpeg, .png or .webp: refused. This
# block only ever denies; photos fall through to the parent folder's rules,
# so an access rule pasted into the root .htaccess still covers them.
<FilesMatch "(?i)^(?!.*\.(jpe?g|png|webp)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Browsers must not guess another type (an image that is secretly HTML).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options nosniff
</IfModule>
