# Nest flyers: Apache rules for the app root (a domain root or a subfolder).
#
# To restrict the whole app (editor, photos and API) to a password, paste the
# block from access-examples/htaccess-basic-auth.txt at the TOP of this file
# (the preflight page prints it with your paths filled in). config.php's
# access rule guards only the API. Every release upload replaces this file:
# paste the block again after each one (docs/deploy.md).
#
# Only lines a restrictive host allows in .htaccess: rewrites, headers and
# FilesMatch. IONOS answers 403 to every page when this file has
# "Options -Indexes -MultiViews" (docs/reports/host-facts.md), so folder
# listings are refused by a rewrite instead, and PHP's error display is left to
# .user.ini and api.php. An "Options", "php_flag" or "<If>" line added here can
# take the whole app down on such a host.

# An internal tool: never indexed. robots.txt counts only at a domain's root,
# and this app often lives in a subfolder, so every answer says it as well.
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # http:// goes to https:// before anything is served. X-Forwarded-Proto
    # covers hosts whose TLS ends at a proxy in front of Apache. (With the staff
    # login pasted above, Apache refuses http:// before any rewrite runs; the
    # <If> lines of that block turn the refusal into this same redirect.)
    # The address comes from the request line as sent, not REQUEST_URI: where
    # MultiViews is on (IONOS, and .htaccess cannot turn it off there), Apache
    # has already swapped api/config for api.php/config, which answers 404.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{THE_REQUEST} ^\S+\s+(?:https?://[^/\s]+)?(/\S*)
    RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L,NE]

    # CGI/FPM hosts drop the Authorization header; hand it to PHP so config.php's
    # Basic auth works (it arrives as REDIRECT_HTTP_AUTHORIZATION after the rewrite).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Code, seed, schema and data folders are never served, in any letter case.
    RewriteRule ^(src|vendor|seed|schema|data)(/|$) - [R=404,L,NC]

    # The API: everything under api/ goes to the front controller. Relative
    # rules and no RewriteBase, so a subfolder and a domain root both work.
    RewriteRule ^api/ api.php [L,QSA]

    # No folder is listed; the app root keeps its index.html.
    RewriteRule ^.+/$ - [R=404,L]
</IfModule>

# Config, tooling, the release manifest, logs and docs are never served, in any letter case.
<FilesMatch "(?i)^(config.*\.php|router\.php|composer\..*|\.user\.ini|release\.json|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
