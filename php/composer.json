{
    "name": "nestshostels/flyers",
    "description": "PHP backend of the Nest branded flyers generator: the same API as the Node server, JSON-file storage, GD photos.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-gd": "Photo processing (the default image processor)",
        "ext-imagick": "Photo processing, used instead of GD when configured"
    },
    "autoload": {
        "psr-4": {
            "NestFlyers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NestFlyers\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
