# Bind address. Keep 127.0.0.1 behind a reverse proxy, or set the office-LAN IP.
# Never expose this app to the public internet: it has no login by design.
HOST=127.0.0.1
PORT=8787
# SQLite file (or the JSON store), uploads/ and renders/ live here. Outside the checkout on the VPS.
DATA_DIR=./data
# Storage driver: sqlite (default), or json for the folder the PHP backend serves (docs/json-storage.md).
# One backend serves a data folder at a time.
STORAGE=sqlite
# Origin the export renderer (headless Chromium) uses to reach this server.
# Defaults to http://127.0.0.1:PORT, or http://HOST:PORT when HOST is a specific IP.
# RENDER_ORIGIN=
RENDER_TIMEOUT_MS=30000

# --- Node-side scripts and checks (scripts/env.ts reads these here, so they work in any shell) ---
# The PHP the scripts and PHP tests run (default: php on PATH), e.g. C:\laragon\bin\php\php-8.4.25-Win32-vs17-x64\php.exe
# PHP_BIN=
# Point npm run test:contract and npm run test:php-smoke at a deployment instead of the local backends.
# Leave these commented when you're done: while CONTRACT_BASE_URL is set, every run is a remote run.
# CONTRACT_BASE_URL=https://nestpass.ai/activities/
# That deployment's folder on this machine, if it is one (lets security.test.ts plant files in its uploads/).
# CONTRACT_DEPLOY_DIR=
# The staff login of a locked deployment (Basic auth). Never put it in CONTRACT_BASE_URL.
# CONTRACT_BASIC_USER=
# CONTRACT_BASIC_PASSWORD=
# Where npm run flyers:post saves flyers from briefs (docs/ai-flyers/README.md). Its own setting, never CONTRACT_BASE_URL.
# FLYERS_BASE_URL=https://nestpass.ai/activities/
# FLYERS_BASIC_USER=
# FLYERS_BASIC_PASSWORD=

# --- The AI assistant (docs/prompts/ai-assistant.md). Off until a provider, its key and the features are set. ---
# openai | anthropic | fake (the fake answers from the examples, for the tests and a demo; it needs no key)
# AI_PROVIDER=openai
# The provider's key. Server-side only: it never reaches api/config, a log line, the ledger or git.
# AI_API_KEY=
# The features that run, separated by commas: flyer ("Create with AI"), share ("Write with AI"), photo ("From a
# photo" on Create with AI: a picture read into the words for "Your idea"). Name photo with flyer: the read is on
# the flyer's page, and shows nowhere without it.
# None until named: a provider and its key alone run nothing.
# AI_FEATURES=flyer,share
# Generations a day of each feature, for the whole site, counted on the Canary Islands day: 3 unless set, 20 at most.
# Every feature has its own count: 3 here is 3 flyers and 3 share texts.
# AI_DAILY_LIMIT=3
# A feature's own number a day, as feature:number pairs separated by commas (share:10,flyer:5): 1 to 20 each.
# A feature it does not name takes AI_DAILY_LIMIT.
# AI_DAILY_LIMITS=share:10
# The flyer's and the share text's model; defaults to gpt-6-luna (openai) or claude-haiku-4-5 (anthropic).
# AI_MODEL=
# A feature's own model, as feature:model pairs separated by commas. One provider and one key serve them all.
# The picture read has a default of its own, the provider's middle model (gpt-6.1-sol, claude-sonnet-5-5): the fast
# ones misread handwriting. AI_MODEL does not change it; only the read's own pair here does, and that model must be
# one that reads pictures.
# AI_MODELS=photo:gpt-6.1-sol
# The provider's effort knob (low | medium | high): speed against depth. One for the whole site: leave it unset when
# any feature runs on a model that refuses it, as claude-haiku-4-5 does.
# AI_EFFORT=
# The provider call's time limit; keep it under the host's request limit.
# AI_TIMEOUT_MS=25000
# 0 switches the AI off even with a key.
# AI_ENABLED=1
