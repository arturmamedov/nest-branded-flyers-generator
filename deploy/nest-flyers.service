# /etc/systemd/system/nest-flyers.service
# sudo systemctl daemon-reload && sudo systemctl enable --now nest-flyers
[Unit]
Description=Nest branded flyers generator
After=network.target

[Service]
Type=simple
User=nestflyers
Group=nestflyers
WorkingDirectory=/opt/nest-flyers
ExecStart=/usr/bin/node dist-server/server/index.js
Environment=NODE_ENV=production
# Loopback behind nginx. Never a public interface: there is no login.
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DATA_DIR=/var/lib/nest-flyers
# Must match where `npx playwright install chromium` put the browser.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/nest-flyers/.browsers
StateDirectory=nest-flyers
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
