# /etc/nginx/sites-available/nest-flyers — office network only.
server {
    listen 80;
    server_name flyers.internal;   # or the VPS's LAN name

    # The app has no login: allow the office range(s), refuse everyone else.
    allow 192.168.1.0/24;          # <- your office network
    # allow 10.8.0.0/24;           # <- VPN range, if any
    deny all;

    # Photos are up to 15 MB; nginx's 1 MB default would reject them.
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;    # exports take a few seconds
    }
}
