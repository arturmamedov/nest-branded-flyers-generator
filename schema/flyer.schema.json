{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "x-nest-trim": true
    },
    "hostel": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "template": {
      "type": "string",
      "enum": [
        "activity",
        "week"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "v": {
          "default": 1,
          "type": "number",
          "const": 1
        },
        "template": {
          "type": "string",
          "enum": [
            "activity",
            "week"
          ]
        },
        "photoMode": {
          "type": "string",
          "enum": [
            "bleed",
            "band",
            "none"
          ]
        },
        "photoCrop": {
          "default": {
            "x": 0.5,
            "y": 0.5,
            "zoom": 1
          },
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -2,
              "maximum": 3
            },
            "y": {
              "type": "number",
              "minimum": -2,
              "maximum": 3
            },
            "zoom": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ]
        },
        "showPill": {
          "default": true,
          "type": "boolean"
        },
        "text": {
          "type": "object",
          "properties": {
            "eyebrow": {
              "type": "string",
              "maxLength": 18
            },
            "headline1": {
              "type": "string",
              "maxLength": 40
            },
            "headline2": {
              "type": "string",
              "maxLength": 40
            },
            "headlineEs": {
              "type": "string",
              "maxLength": 140
            },
            "askEn": {
              "type": "string",
              "maxLength": 60
            },
            "askEs": {
              "type": "string",
              "maxLength": 70
            },
            "handle": {
              "type": "string",
              "maxLength": 18
            },
            "tag": {
              "type": "string",
              "maxLength": 12
            }
          },
          "required": [
            "eyebrow",
            "headline1",
            "headline2",
            "headlineEs",
            "askEn",
            "askEs",
            "handle",
            "tag"
          ]
        },
        "chips": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "when",
                  "where",
                  "cost"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 12
              },
              "value": {
                "type": "string",
                "maxLength": 90
              }
            },
            "required": [
              "key",
              "label",
              "value"
            ]
          }
        },
        "extras": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32
          }
        },
        "week": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "maxLength": 30
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "time": {
                "type": "string",
                "maxLength": 20
              },
              "cost": {
                "type": "string",
                "maxLength": 30
              },
              "shortName": {
                "type": "string",
                "maxLength": 60
              }
            },
            "required": [
              "day",
              "name",
              "time",
              "cost"
            ]
          }
        },
        "colors": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "ink": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "mark": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "bg",
            "ink",
            "accent",
            "mark"
          ]
        },
        "overrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "dx": {
                "default": 0,
                "type": "number"
              },
              "dy": {
                "default": 0,
                "type": "number"
              },
              "scale": {
                "default": 1,
                "type": "number",
                "minimum": 0.6,
                "maximum": 1.4
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "when",
                    "where",
                    "cost"
                  ]
                }
              }
            }
          }
        },
        "doodles": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "maxLength": 80
              },
              "anchor": {
                "type": "string",
                "enum": [
                  "canvas",
                  "photoLeft",
                  "photoRight"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1080
              },
              "rot": {
                "default": 0,
                "type": "number"
              },
              "flipX": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "slug",
              "x",
              "y",
              "w"
            ]
          }
        }
      },
      "required": [
        "template",
        "photoMode",
        "text",
        "chips",
        "extras",
        "colors",
        "doodles"
      ]
    },
    "photoId": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "title",
    "hostel",
    "template",
    "data",
    "photoId"
  ]
}
